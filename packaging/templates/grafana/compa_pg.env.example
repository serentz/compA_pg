# ============================================================
# compA_pg : parametres de l'archive « grafana »
# Copier ce fichier en scripts/compa_pg.env, adapter, puis : sudo ./install.sh
# compa_pg.env contient un mot de passe : ne jamais le versionner.
# Mot de passe : 8 caracteres minimum, lettres, chiffres et . _ @ % + = - seulement
# (il est ecrit dans /etc/default/grafana-server, lu par systemd).
# ============================================================
# Base de resultats (archive « depot »), lue avec le login grafana_ro
COMPA_PG_HOST=192.168.60.11
COMPA_PG_PORT=5432
COMPA_PG_DB=compa
COMPA_PG_PASSWORD=CHANGEME_grafana    # mot de passe de grafana_ro (GRAFANA_RO_PASSWORD de l'archive depot)

# Facultatif : mot de passe admin de Grafana, pour que verify.sh teste la connexion de la source de donnees
GRAFANA_ADMIN_PASSWORD=
