# ============================================================
# compA_pg : parametres de l'archive « depot » (base de resultats)
# Copier ce fichier en scripts/compa_pg.env, adapter, puis : sudo ./install.sh
# compa_pg.env contient des mots de passe : ne jamais le versionner.
# Mots de passe : 8 caracteres minimum, lettres, chiffres et . _ @ % + = - seulement.
# ============================================================
PG_PORT=5432                          # port du cluster PostgreSQL qui heberge la base de resultats
DEPOT_DB=compa                        # nom de la base de resultats
DEPOT_OWNER=compa_app                 # login proprietaire de la base (utilise par le comparateur)
DEPOT_OWNER_PASSWORD=CHANGEME_compa_app
GRAFANA_RO_PASSWORD=CHANGEME_grafana  # login grafana_ro (lecture seule, pour Grafana)
ALLOW_SUBNET=192.168.60.0/24          # reseau autorise a joindre la base (comparateur et Grafana)
