# ============================================================
# compA_pg : parametres de l'archive « clusters de test »
# Facultatif : sans ce fichier, install.sh demande le mot de passe de compa_app.
# Copier en scripts/compa_pg.env pour une installation sans question. Ne jamais le versionner.
# ============================================================
COMPA_APP_PASSWORD=CHANGEME_compa_app     # superutilisateur de TEST compa_app sur les 2 clusters (8 caracteres minimum)
COMPA_NET=192.168.60.0/24                 # reseau autorise a joindre les 2 clusters
