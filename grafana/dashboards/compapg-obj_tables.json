          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case type_diff when 'ONLY_R1' then 'Seulement R1' when 'ONLY_R2' then 'Seulement R2' else 'Différent' end as \"Type\", table_name as \"Table\", column_name as \"Colonne\", r1_type_name as \"R1 type\", r1_not_null as \"R1 not null\", r1_default_value as \"R1 défaut\", r1_identity as \"R1 identity\", r1_generated as \"R1 générée\", r2_type_name as \"R2 type\", r2_not_null as \"R2 not null\", r2_default_value as \"R2 défaut\", r2_identity as \"R2 identity\", r2_generated as \"R2 générée\", case when type_diff = 'DIFF' then nullif(concat_ws(', ', case when r1_type_name is distinct from r2_type_name then 'type_name' end, case when r1_not_null is distinct from r2_not_null then 'not_null' end, case when r1_default_value is distinct from r2_default_value then 'default_value' end, case when r1_identity is distinct from r2_identity then 'identity' end, case when r1_generated is distinct from r2_generated then 'generated' end), '') end as \"Champs en écart\", case when attendu then 'Oui' else '' end as \"Attendu\" from compa_pg.diff_obj_tables where run_id = nullif(${run:sqlstring}, '')::bigint order by type_diff, table_name, column_name",
          "refId": "A"
        }
      ],
