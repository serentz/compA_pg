          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "select case type_diff when 'ONLY_R1' then 'Seulement R1' when 'ONLY_R2' then 'Seulement R2' else 'Différent' end as \"Type\", object_name as \"Nom\", case object_type when 'P' then 'Procédure' when 'F' then 'Fonction' when 'V' then 'Vue' when 'M' then 'Vue matérialisée' when 'TR' then 'Trigger' else object_type end as \"Objet\", r1_nb_lignes as \"R1 lignes\", r2_nb_lignes as \"R2 lignes\", left(r1_hash, 10) as \"R1 hash\", left(r2_hash, 10) as \"R2 hash\", case when attendu then 'Oui' else '' end as \"Attendu\" from compa_pg.diff_obj_source where run_id = nullif(${run:sqlstring}, '')::bigint order by type_diff, object_type, object_name",
          "refId": "A"
        }
      ],
