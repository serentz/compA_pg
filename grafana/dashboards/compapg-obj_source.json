    {
      "id": 7,
      "type": "table",
      "title": "Code source : ${objet:text}",
      "datasource": {
        "type": "grafana-postgresql-datasource",
        "uid": "compa_pg_ds"
      },
      "gridPos": {
        "h": 16,
        "w": 24,
        "x": 0,
        "y": 13
      },
      "targets": [
        {
          "datasource": {
            "type": "grafana-postgresql-datasource",
            "uid": "compa_pg_ds"
          },
          "editorMode": "code",
          "format": "table",
          "rawQuery": true,
          "rawSql": "with src as (select r1_source, r2_source from compa_pg.diff_obj_source where run_id = nullif(${run:sqlstring}, '')::bigint and object_name = split_part(${objet:sqlstring}, '|', 1) and object_type = split_part(${objet:sqlstring}, '|', 2)), a as (select t.n, t.l from src, regexp_split_to_table(coalesce(r1_source, ''), E'\\n') with ordinality as t(l, n)), b as (select t.n, t.l from src, regexp_split_to_table(coalesce(r2_source, ''), E'\\n') with ordinality as t(l, n)) select coalesce(a.n, b.n) as \"Ligne\", a.l as \"R1\", b.l as \"R2\", case when a.l is distinct from b.l then '≠' else '' end as \"Écart\" from a full join b on a.n = b.n where ${filtre:sqlstring} = 'toutes' or a.l is distinct from b.l order by 1",
          "refId": "A"
        }
      ],
      "fieldConfig": {
        "defaults": {
          "custom": {
            "align": "auto",
            "cellOptions": {
              "type": "auto"
            },
            "filterable": true,
            "inspect": false
          },
